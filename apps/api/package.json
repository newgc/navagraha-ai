{
  "name": "@navagraha/api",
  "version": "0.1.0",
  "private": true,
  "description": "Navagraha AI API — NestJS modular monolith (FS §2.2).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@navagraha/db": "workspace:*",
    "@navagraha/domain": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "exceljs": "^4.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
