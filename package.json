{
  "name": "navagraha-ai",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @navagraha/db generate",
    "db:migrate": "pnpm --filter @navagraha/db migrate",
    "db:seed": "pnpm --filter @navagraha/db seed",
    "dev:api": "pnpm --filter @navagraha/api dev",
    "dev:web": "pnpm --filter @navagraha/web dev",
    "db:import-temples": "pnpm --filter @navagraha/db import-temples"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
