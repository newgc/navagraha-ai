# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://navagraha:navagraha@localhost:5432/navagraha
API_PORT=4000
NODE_ENV=development
# HMAC key for sign-in codes. Generate your own: openssl rand -base64 48
# Production refuses any value containing "change-me".
AUTH_SECRET=change-me-local-development-only-0123456789
# Sign-in codes are printed to the API log until an SMS provider is chosen (D-11).
OTP_SENDER=console
